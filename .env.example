# Leave DATABASE_URL unset to use the embedded Postgres (PGlite) in .pglite/.
# Set it to use the docker-compose Postgres instead (`npm run db:up`).
DATABASE_URL=postgres://nms:nms@localhost:5433/nms_dashboard

# Where the API (and the live dashboard) listens. The MCP server talks to it on this URL.
PORT=4300
API_URL=http://localhost:4300
